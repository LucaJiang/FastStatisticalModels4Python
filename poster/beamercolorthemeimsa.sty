% Gemini theme
% https://github.com/anishathalye/gemini
% Modified by Dev Singh to fit the Illinois Mathematics and Science Academy (IMSA) Brand Guidelines
% Style guidelines obtained from: https://www.imsa.edu/marcom-toolkit/

% ====================
% Definitions
% ====================

\definecolor{imsablue}{HTML}{B01117}
\definecolor{imsalightblue}{HTML}{E07541}
\definecolor{cityumaroon}{HTML}{981B49}
\definecolor{cityupaper}{HTML}{FFF8F2}

% Extra colors
\definecolor{lightgray}{HTML}{F6E8E1}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=imsablue}

% Headline
\setbeamercolor{headline}{fg=imsablue,bg=cityupaper}
\setbeamercolor{headline title}{fg=imsablue}
\setbeamercolor{headline author}{fg=cityumaroon}
\setbeamercolor{headline institute}{fg=imsablue}
\setbeamercolor{headline rule}{bg=imsalightblue}

% Block
\setbeamercolor{block title}{fg=imsablue,bg=white}
\setbeamercolor{block separator}{bg=imsalightblue}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=imsablue,bg=lightgray}
\setbeamercolor{block alerted separator}{bg=cityumaroon}
\setbeamercolor{block alerted body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=imsablue}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
